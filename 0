// ======================================================
// STATUS JSON
// ======================================================

void sendStatus()
{

    String debug;

    debug += "ESP32-S3\n";

    debug += "Wi-Fi: ";
    debug += wifiStatus;
    debug += "\n";

    debug += "Receptor IR GPIO: ";
    debug += String(IR_RECEIVER_PIN);
    debug += "\n";

    debug += "Transmissor IR GPIO: ";
    debug += String(IR_TRANSMITTER_PIN);
    debug += "\n";

    debug += "LED vermelho GPIO: ";
    debug += String(LED_RED);
    debug += "\n";

    debug += "LED azul GPIO: ";
    debug += String(LED_BLUE);
    debug += "\n";

    debug += "Sinal armazenado: ";
    debug += signalStored ? "SIM" : "NAO";
    debug += "\n";

    debug += "Modo repeticao: ";
    debug += repeatMode ? "ATIVO" : "PARADO";

    String json = "{";

    json += "\"wifi\":\"";
    json += wifiStatus;
    json += "\",";

    json += "\"ir\":\"";
    json += irStatus;
    json += "\",";

    json += "\"tx\":\"";
    json += txStatus;
    json += "\",";

    json += "\"system\":\"";
    json += systemStatus;
    json += "\",";

    json += "\"event\":\"";

    if(signalStored)
        json += "Sinal IR recebido";
    else
        json += "Aguardando controle";

    json += "\",";

    json += "\"protocol\":\"";
    json += lastProtocol;
    json += "\",";

    json += "\"code\":\"";
    json += lastCode;
    json += "\",";

    json += "\"bits\":";
    json += String(lastBits);
    json += ",";

    json += "\"debug\":\"";

    for(size_t i=0;i<debug.length();i++)
    {

        char c = debug[i];

        if(c == '\n')
            json += "\\n";

        else if(c == '"')
            json += "\\\"";

        else
            json += c;

    }

    json += "\"";

    json += "}";

    server.send(
        200,
        "application/json",
        json
    );
}

// ======================================================
// RECEBER IR
// ======================================================

void receiveIR()
{

    if(!irrecv.decode(&results))
        return;

    signalStored = true;

    lastReceive = millis();

    lastProtocol =
        typeToString(
            results.decode_type,
            results.repeat
        );

    lastCode =
        resultToHexidecimal(&results);

    lastBits =
        results.bits;

    irStatus =
        "SINAL RECEBIDO";

    Serial.println();
    Serial.println(
        "================================="
    );

    Serial.println(
        ">>> SINAL IR RECEBIDO <<<"
    );

    Serial.print(
        "PROTOCOLO: "
    );

    Serial.println(
        lastProtocol
    );

    Serial.print(
        "CODIGO: "
    );

    Serial.println(
        lastCode
    );

    Serial.print(
        "BITS: "
    );

    Serial.println(
        lastBits
    );

    Serial.print(
        "RAW: "
    );

    Serial.println(
        results.rawlen
    );

    Serial.println(
        "SINAL ARMAZENADO."
    );

    Serial.println(
        "================================="
    );

    uint16_t* raw =
        resultToRawArray(&results);

    if(raw != nullptr)
    {

        uint16_t length =
            getCorrectedRawLength(
                &results
            );

        if(length > 400)
            length = 400;

        for(
            uint16_t i=0;
            i<length;
            i++
        )
        {
            lastRaw[i] = raw[i];
        }

        lastRawLength =
            length;

        delete[] raw;
    }
    else
    {
        lastRawLength = 0;
    }

    ledsReceive();

    irrecv.resume();
}

// ======================================================
// TRANSMITIR IR
// ======================================================

void transmitIR()
{

    if(!signalStored)
        return;

    if(lastRawLength == 0)
        return;

    irsend.sendRaw(
        lastRaw,
        lastRawLength,
        38
    );

    lastTx = millis();

    Serial.println(
        "[TX] SINAL IR ENVIADO"
    );
}

// ======================================================
// INICIAR TX
// ======================================================

void startRepeat()
{

    if(!signalStored)
    {

        server.send(
            400,
            "text/plain",
            "Nenhum sinal armazenado."
        );

        return;
    }

    repeatMode = true;

    txStatus =
        "TRANSMITINDO";

    Serial.println(
        "[TX] TRANSMISSAO CONTINUA INICIADA"
    );

    server.send(
        200,
        "text/plain",
        "OK"
    );
}

// ======================================================
// PARAR TX
// ======================================================

void stopRepeat()
{

    repeatMode = false;

    txStatus =
        "PARADO";

    Serial.println(
        "[TX] TRANSMISSAO PARADA"
    );

    server.send(
        200,
        "text/plain",
        "OK"
    );
}

// ======================================================
// WIFI
// ======================================================

void connectWiFi()
{

    wifiStatus =
        "CONECTANDO";

    Serial.println();
    Serial.println(
        "Conectando ao Wi-Fi..."
    );

    WiFi.mode(WIFI_STA);

    WiFi.begin(
        WIFI_SSID,
        WIFI_PASSWORD
    );

    unsigned long start =
        millis();

    while(
        WiFi.status() != WL_CONNECTED
    )
    {

        digitalWrite(
            LED_BLUE,
            HIGH
        );

        delay(200);

        digitalWrite(
            LED_BLUE,
            LOW
        );

        delay(200);

        Serial.print(
            "."
        );

        if(
            millis() -
            start >
            20000
        )
        {

            wifiStatus =
                "DESCONECTADO";

            systemStatus =
                "ERRO WIFI";

            ledsError();

            Serial.println();
            Serial.println(
                "ERRO: Wi-Fi"
            );

            return;
        }
    }

    wifiStatus =
        "CONECTADO";

    Serial.println();
    Serial.println(
        "Wi-Fi conectado."
    );

    Serial.print(
        "IP: "
    );

    Serial.println(
        WiFi.localIP()
    );
}

// ======================================================
// SETUP
// ======================================================

void setup()
{

    Serial.begin(
        115200
    );

    delay(1000);

    pinMode(
        LED_RED,
        OUTPUT
    );

    pinMode(
        LED_BLUE,
        OUTPUT
    );

    ledsStartup();

    Serial.println();
    Serial.println(
        "================================="
    );

    Serial.println(
        "ESP32-S3 IR CONTROL"
    );

    Serial.println(
        "INICIALIZANDO SISTEMA"
    );

    Serial.println(
        "================================="
    );

    Serial.print(
        "IR RX GPIO: "
    );

    Serial.println(
        IR_RECEIVER_PIN
    );

    Serial.print(
        "IR TX GPIO: "
    );

    Serial.println(
        IR_TRANSMITTER_PIN
    );

    Serial.print(
        "LED VERMELHO GPIO: "
    );

    Serial.println(
        LED_RED
    );

    Serial.print(
        "LED AZUL GPIO: "
    );

    Serial.println(
        LED_BLUE
    );

    // IR
    irrecv.enableIRIn();

    irsend.begin();

    // Wi-Fi
    connectWiFi();

    if(
        WiFi.status() ==
        WL_CONNECTED
    )
    {

        systemStatus =
            "PRONTO";

        ledsNormal();

        server.on(
            "/",
            []()
            {
                server.send(
                    200,
                    "text/html",
                    PAGE
                );
            }
        );

        server.on(
            "/api/status",
            sendStatus
        );

        server.on(
            "/api/repeat/start",
            startRepeat
        );

        server.on(
            "/api/repeat/stop",
            stopRepeat
        );

        server.begin();

        Serial.println();
        Serial.println(
            "SERVIDOR WEB ATIVO"
        );

        Serial.print(
            "ABRA: http://"
        );

        Serial.println(
            WiFi.localIP()
        );

        Serial.println();
        Serial.println(
            "AGUARDANDO CONTROLE..."
        );

    }
}

// ======================================================
// LOOP
// ======================================================

void loop()
{

    server.handleClient();

    // Verifica Wi-Fi
    if(
        WiFi.status() !=
        WL_CONNECTED
    )
    {

        wifiStatus =
            "DESCONECTADO";

        systemStatus =
            "ERRO WIFI";

        ledsError();

    }
    else
    {

        wifiStatus =
            "CONECTADO";

        if(
            systemStatus ==
            "ERRO WIFI"
        )
        {
            systemStatus =
                "PRONTO";

            ledsNormal();
        }

    }

    // Receber controle
    receiveIR();

    // Voltar para estado de espera
    if(
        !repeatMode &&
        millis() - lastReceive > 1200
    )
    {

        if(
            signalStored
        )
        {
            irStatus =
                "AGUARDANDO";
        }
        else
        {
            irStatus =
                "AGUARDANDO";
        }

    }

    // Transmissão contínua
    if(
        repeatMode &&
        signalStored
    )
    {

        if(
            millis() -
            lastTx >=
            300
        )
        {

            transmitIR();

            txStatus =
                "TRANSMITINDO";
        }
    }

    delay(2);
}
