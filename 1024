// ============================================================
// SETUP
// ============================================================

void setup() {

    Serial.begin(115200);

    delay(2000);

    Serial.println();
    Serial.println(
        "======================================"
    );
    Serial.println(
        " ESP32-S3 USB PENDRIVE WEB MANAGER"
    );
    Serial.println(
        "======================================"
    );

    // ========================================================
    // USB HOST
    // ========================================================

    USBHost.setCore(0);

    usbHostStarted =
        USBHost.begin();

    if (usbHostStarted) {

        Serial.println(
            "[USB] USB Host iniciado."
        );

    } else {

        Serial.println(
            "[USB] FALHA ao iniciar Host."
        );
    }

    Serial.println(
        "[USB] D- = GPIO19"
    );

    Serial.println(
        "[USB] D+ = GPIO20"
    );

    // ========================================================
    // WI-FI
    // ========================================================

    WiFi.mode(
        WIFI_STA
    );

    WiFi.setHostname(
        "ESP32-S3-PENDRIVE"
    );

    WiFi.begin(
        WIFI_SSID,
        WIFI_PASSWORD
    );

    Serial.println();
    Serial.println(
        "[WIFI] Conectando..."
    );

    unsigned long inicio =
        millis();

    while (
        WiFi.status() != WL_CONNECTED &&
        millis() - inicio < 20000
    ) {

        Serial.print(".");

        delay(500);
    }

    Serial.println();

    if (
        WiFi.status() ==
        WL_CONNECTED
    ) {

        Serial.println(
            "[WIFI] CONECTADO!"
        );

        Serial.print(
            "[WIFI] SSID: "
        );

        Serial.println(
            WiFi.SSID()
        );

        Serial.print(
            "[WIFI] IP: "
        );

        Serial.println(
            WiFi.localIP()
        );

    } else {

        Serial.println(
            "[WIFI] FALHA."
        );
    }

    // ========================================================
    // ROTAS
    // ========================================================

    server.on(
        "/",
        HTTP_GET,
        paginaWeb
    );

    server.on(
        "/api/info",
        HTTP_GET,
        apiInfo
    );

    server.on(
        "/api/files",
        HTTP_GET,
        apiArquivos
    );

    server.on(
        "/download",
        HTTP_GET,
        baixarArquivo
    );

    server.on(
        "/delete",
        HTTP_POST,
        excluirArquivo
    );

    server.on(
        "/mkdir",
        HTTP_POST,
        criarPasta
    );

    server.on(
        "/upload",
        HTTP_POST,
        []() {

            server.send(
                200,
                "text/plain",
                "Upload recebido"
            );

        },
        receberUpload
    );

    server.begin();

    Serial.println();
    Serial.println(
        "[WEB] Servidor iniciado."
    );

    if (
        WiFi.status() ==
        WL_CONNECTED
    ) {

        Serial.print(
            "[WEB] Acesse: http://"
        );

        Serial.println(
            WiFi.localIP()
        );
    }
}

// ============================================================
// LOOP
// ============================================================

void loop() {

    USBHost.task();

    verificarPendrive();

    server.handleClient();

    delay(2);
}
