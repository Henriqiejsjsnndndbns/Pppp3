// ============================================================
// UPLOAD
// ============================================================

File arquivoUpload;

void receberUpload() {

    verificarPendrive();

    if (!pendriveMontado) {
        return;
    }

    HTTPUpload& upload =
        server.upload();

    if (
        upload.status ==
        UPLOAD_FILE_START
    ) {

        String nome =
            upload.filename;

        nome.replace(
            "\\",
            "/"
        );

        int barra =
            nome.lastIndexOf('/');

        if (barra >= 0) {
            nome =
                nome.substring(
                    barra + 1
                );
        }

        if (
            nome.length() == 0 ||
            nome.indexOf("..") >= 0
        ) {

            Serial.println(
                "[UPLOAD] Nome inválido."
            );

            return;
        }

        String path =
            "/" + nome;

        Serial.print(
            "[UPLOAD] Iniciando: "
        );

        Serial.println(
            path
        );

        arquivoUpload =
            USBMSCFS.open(
                path,
                FILE_WRITE
            );

        if (!arquivoUpload) {

            Serial.println(
                "[UPLOAD] ERRO ao criar arquivo."
            );

            return;
        }
    }

    else if (
        upload.status ==
        UPLOAD_FILE_WRITE
    ) {

        if (arquivoUpload) {

            arquivoUpload.write(
                upload.buf,
                upload.currentSize
            );
        }
    }

    else if (
        upload.status ==
        UPLOAD_FILE_END
    ) {

        if (arquivoUpload) {

            arquivoUpload.close();

            Serial.print(
                "[UPLOAD] Concluído: "
            );

            Serial.print(
                upload.totalSize
            );

            Serial.println(
                " bytes"
            );
        }
    }

    else if (
        upload.status ==
        UPLOAD_FILE_ABORTED
    ) {

        if (arquivoUpload) {
            arquivoUpload.close();
        }

        Serial.println(
            "[UPLOAD] Cancelado."
        );
    }
}

