// ============================================================
// SEGURANÇA DE CAMINHO
// ============================================================

bool caminhoValido(String path) {

    if (path.length() == 0) {
        return false;
    }

    if (!path.startsWith("/")) {
        path = "/" + path;
    }

    if (path.indexOf("..") >= 0) {
        return false;
    }

    if (path.indexOf("\\") >= 0) {
        return false;
    }

    return true;
}

// ============================================================
// TAMANHO HUMANO
// ============================================================

String tamanhoHumano(uint64_t bytes) {

    if (bytes < 1024)
        return String(bytes) + " B";

    if (bytes < 1024ULL * 1024)
        return String((double)bytes / 1024.0, 1) + " KB";

    if (bytes < 1024ULL * 1024 * 1024)
        return String((double)bytes / (1024.0 * 1024.0), 1) + " MB";

    return String(
        (double)bytes /
        (1024.0 * 1024.0 * 1024.0),
        1
    ) + " GB";
}

// ============================================================
// TENTAR MONTAR PENDRIVE
// ============================================================

void verificarPendrive() {

    bool conectado = USBHostMSC.mounted();

    if (!conectado) {

        if (pendriveMontado) {

            Serial.println(
                "[USB] Pendrive removido."
            );

            if (pendriveMontado) {
                USBMSCFS.end();
            }

            pendriveMontado = false;
        }

        return;
    }

    if (pendriveMontado) {
        return;
    }

    Serial.println();
    Serial.println(
        "[USB] Pendrive encontrado."
    );

    Serial.println(
        "[USB] Tentando montar FAT..."
    );

    if (
        USBMSCFS.begin(
            "/usb",
            10,
            false
        )
    ) {

        pendriveMontado = true;

        Serial.println(
            "[USB] PENDRIVE MONTADO!"
        );

        Serial.print(
            "[USB] Tamanho: "
        );

        Serial.println(
            tamanhoHumano(
                USBMSCFS.totalBytes()
            )
        );

        Serial.print(
            "[USB] Usado: "
        );

        Serial.println(
            tamanhoHumano(
                USBMSCFS.usedBytes()
            )
        );

    } else {

        ultimoErro =
            "Falha ao montar FAT";

        Serial.println(
            "[USB] ERRO: falha ao montar."
        );
    }
}

// ============================================================
// LISTAR ARQUIVOS
// ============================================================

void apiArquivos() {

    verificarPendrive();

    if (!pendriveMontado) {

        server.send(
            503,
            "application/json",
            "{\"erro\":\"Pendrive não montado\"}"
        );

        return;
    }

    String path =
        server.hasArg("path")
        ? server.arg("path")
        : "/";

    if (!caminhoValido(path)) {

        server.send(
            400,
            "application/json",
            "{\"erro\":\"Caminho inválido\"}"
        );

        return;
    }

    File pasta =
        USBMSCFS.open(path);

    if (!pasta || !pasta.isDirectory()) {

        server.send(
            404,
            "application/json",
            "{\"erro\":\"Pasta não encontrada\"}"
        );

        return;
    }

    String json = "[";

    bool primeiro = true;

    File arquivo =
        pasta.openNextFile();

    while (arquivo) {

        if (!primeiro) {
            json += ",";
        }

        primeiro = false;

        json += "{";

        json += "\"nome\":\"";
        json += arquivo.name();
        json += "\",";

        json += "\"diretorio\":";
        json +=
            arquivo.isDirectory()
            ? "true"
            : "false";

        json += ",";

        json += "\"tamanho\":";
        json += String(
            (uint64_t)arquivo.size()
        );

        json += "}";

        arquivo.close();

        arquivo =
            pasta.openNextFile();
    }

    pasta.close();

    json += "]";

    server.send(
        200,
        "application/json",
        json
    );
}

// ============================================================
// INFORMAÇÕES DO PENDRIVE
// ============================================================

void apiInfo() {

    verificarPendrive();

    String json = "{";

    json += "\"conectado\":";
    json +=
        USBHostMSC.mounted()
        ? "true"
        : "false";

    json += ",";

    json += "\"montado\":";
    json +=
        pendriveMontado
        ? "true"
        : "false";

    if (pendriveMontado) {

        json += ",";

        json += "\"total\":";
        json += String(
            USBMSCFS.totalBytes()
        );

        json += ",";

        json += "\"usado\":";
        json += String(
            USBMSCFS.usedBytes()
        );

        json += ",";

        json += "\"livre\":";
        json += String(
            USBMSCFS.totalBytes() -
            USBMSCFS.usedBytes()
        );

        json += ",";

        json += "\"setor\":";
        json += String(
            USBMSCFS.sectorSize()
        );

        json += ",";

        json += "\"setores\":";
        json += String(
            USBMSCFS.numSectors()
        );
    }

    json += ",";

    json += "\"wifi\":\"";
    json += WiFi.SSID();
    json += "\"";

    json += ",";

    json += "\"ip\":\"";
    json += WiFi.localIP().toString();
    json += "\"";

    json += ",";

    json += "\"rssi\":";
    json += String(
        WiFi.RSSI()
    );

    json += "}";

    server.send(
        200,
        "application/json",
        json
    );
}

// ============================================================
// DOWNLOAD
// ============================================================

void baixarArquivo() {

    verificarPendrive();

    if (!pendriveMontado) {

        server.send(
            503,
            "text/plain",
            "Pendrive não montado"
        );

        return;
    }

    if (!server.hasArg("path")) {

        server.send(
            400,
            "text/plain",
            "Path ausente"
        );

        return;
    }

    String path =
        server.arg("path");

    if (!caminhoValido(path)) {

        server.send(
            400,
            "text/plain",
            "Path inválido"
        );

        return;
    }

    File arquivo =
        USBMSCFS.open(path, "r");

    if (!arquivo ||
        arquivo.isDirectory()) {

        server.send(
            404,
            "text/plain",
            "Arquivo não encontrado"
        );

        return;
    }

    server.sendHeader(
        "Content-Disposition",
        "attachment; filename=\"" +
        String(arquivo.name()) +
        "\""
    );

    server.streamFile(
        arquivo,
        "application/octet-stream"
    );

    arquivo.close();
}

// ============================================================
// EXCLUIR
// ============================================================

void excluirArquivo() {

    verificarPendrive();

    if (!pendriveMontado) {

        server.send(
            503,
            "application/json",
            "{\"erro\":\"Pendrive não montado\"}"
        );

        return;
    }

    if (!server.hasArg("path")) {

        server.send(
            400,
            "application/json",
            "{\"erro\":\"Path ausente\"}"
        );

        return;
    }

    String path =
        server.arg("path");

    if (!caminhoValido(path)) {

        server.send(
            400,
            "application/json",
            "{\"erro\":\"Path inválido\"}"
        );

        return;
    }

    if (USBMSCFS.remove(path)) {

        server.send(
            200,
            "application/json",
            "{\"ok\":true}"
        );

    } else {

        server.send(
            500,
            "application/json",
            "{\"erro\":\"Não foi possível excluir\"}"
        );
    }
}

